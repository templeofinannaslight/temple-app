# Auth0 — Native (PKCE) configuration
# Native Auth0 apps do not use a client secret; values below are embedded in the
# app binary and are safe to ship. Treat as configuration, not secrets.
# Expo exposes vars prefixed with EXPO_PUBLIC_ to the JS runtime.

# Auth0 tenant domain (e.g. your-tenant.us.auth0.com — no protocol)
EXPO_PUBLIC_AUTH0_DOMAIN=

# Native application Client ID from the Auth0 Dashboard
EXPO_PUBLIC_AUTH0_CLIENT_ID=

# API identifier (audience) for access tokens. Leave blank to receive an
# opaque token usable only against /userinfo.
EXPO_PUBLIC_AUTH0_AUDIENCE=

# OAuth scopes. offline_access enables refresh tokens.
EXPO_PUBLIC_AUTH0_SCOPE=openid profile email offline_access

# URL the post-login WebView (WelcomeScreen) loads. Use the localhost form
# while developing the temple-www site locally; switch to the production URL
# for preview / production builds.
# EXPO_PUBLIC_TEMPLE_WWW_URL=https://www.templeofinannaslight.org
EXPO_PUBLIC_TEMPLE_WWW_URL=http://localhost:3001

# When "true", the AppNavigator skips the LoginScreen and drops straight
# onto the WebView. Useful for previewing the post-login UX in development
# without going through Auth0 universal login on every reload.
# EXPO_PUBLIC_DISABLE_AUTH=true
